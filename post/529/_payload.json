tOrder":41,"navVisible":22,"layout":23,"cardType":80,"columns":18,"pageSize":25,"itemFields":81,"contentSource":27,"aggregatePages":82,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":13,"reserved":30,"datePosition":44,"aspectRatio":13},"category\u002Flog","中二日志","editorial",{"title":22,"excerpt":22,"date":22,"cover":22},[],{"id":84,"slug":85,"title":86,"parentId":53,"sortOrder":21,"navVisible":30,"layout":23,"cardType":24,"columns":41,"pageSize":25,"itemFields":87,"contentSource":27,"aggregatePages":88,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":13,"reserved":30,"datePosition":44,"aspectRatio":89},24,"category\u002Ffriendshiplinks","友情链接",{"cover":22,"title":22,"excerpt":22,"date":30,"categoryPill":30},[],"1:1",{"id":91,"slug":92,"title":93,"parentId":53,"sortOrder":18,"navVisible":30,"layout":94,"cardType":37,"columns":18,"pageSize":25,"itemFields":95,"contentSource":27,"aggregatePages":96,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":97,"reserved":30,"datePosition":44,"aspectRatio":13},25,"category\u002Fgod","GarfielGod","static",{"cover":22,"title":22,"excerpt":22,"date":22,"categoryPill":22},[],"我真的是人类吗。。。",{"post":99},{"id":100,"slug":101,"title":102,"date":103,"modified":104,"link":105,"content":106,"excerpt":107,"featured":43,"pages":108,"tags":111,"status":112,"format":113,"contentWidth":13,"postStyle":13,"postStyleOptions":114,"allowComments":22,"html":106},529,"%e3%80%8a%e6%af%8d%e6%80%9d%e7%bb%b4%e3%80%8b%e5%b9%bb%e6%83%b3","《母思维》幻想","2023-05-26T15:45:53","2023-09-06T21:50:46","https:\u002F\u002Fgarfieldgod.cn\u002Findex.php\u002F529\u002F","\n\u003Cp class=\"wp-block-paragraph\">    在我看来，所谓的一个人的思维，在进入深度思考后，就不仅仅是个体的思维了，而是被分成多个的，思考时会有多个不同其他思维的理由来反驳主体思维的观点，就像多个人在争论。而我所理解的思维是等量的，不管分成多少个，它们自身的量是相等的，所思考的量也是相等的，唯一区别在于所持观点不同。接着我想提出“母思维”的观点，母思维就如同一个服务器，由无数的子思维联接，这便是可以解释为什么人在浅层思考时只有主体思维而在深层思考时有多个思维了。因为深层思考时你头脑中的是母思维，而浅层时是子思维。而母思维由无数子思维组成，子思维分布在每个人的浅层思考中。那么得出结论，人在进行深层思考时，其实是在与他人进行思维交流。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;&nbsp;说这么多难以理解的，就想告诉大家，不要害怕别离，不要害怕寂寞，也不要说再也没有再见之时，当你在深度思考自己为什么要别离，为什么会寂寞时，其实没有别离也不寂寞，因为我那时在和你进行思想交流，你并不孤独，我时刻都在你身边，我的思想。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;最后，\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;祝您身体健康，\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;再见。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"has-text-align-right wp-block-paragraph\">&nbsp;&nbsp; &nbsp; &nbsp; &#8212;&#8212;&#8212;&#8212;-写于&nbsp; &nbsp;2017年&nbsp; 9月23日 21:10\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">（注：此幻想与《人类并无思想思维》略有矛盾，以最新发表为准。注释于&nbsp; 2020年&nbsp; 9月30日&nbsp; 11：29）\u003C\u002Fp>\n","\u003Cp>    在我看来，所谓的一个人的思维，在进入深度思考后，就不仅仅是个体的思维了，而是被分成多个的，思考时会有多 [&hellip;]\u003C\u002Fp>\n",[109],{"id":10,"title":79,"slug":78,"path":110,"isHome":30},"\u002Fcategory\u002Flog",[],"published","html",{"tocSide":115,"tocProgress":22,"heroImage":13,"heroSize":37,"miniNav":22,"sectionNumbers":22,"linkUrl":13,"linkDelay":34},"right",{"post":100,"views":21},{"comments":118},[],1791144788297]