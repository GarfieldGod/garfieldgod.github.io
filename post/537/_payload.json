tOrder":41,"navVisible":22,"layout":23,"cardType":80,"columns":18,"pageSize":25,"itemFields":81,"contentSource":27,"aggregatePages":82,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":13,"reserved":30,"datePosition":44,"aspectRatio":13},"category\u002Flog","中二日志","editorial",{"title":22,"excerpt":22,"date":22,"cover":22},[],{"id":84,"slug":85,"title":86,"parentId":53,"sortOrder":21,"navVisible":30,"layout":23,"cardType":24,"columns":41,"pageSize":25,"itemFields":87,"contentSource":27,"aggregatePages":88,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":13,"reserved":30,"datePosition":44,"aspectRatio":89},24,"category\u002Ffriendshiplinks","友情链接",{"cover":22,"title":22,"excerpt":22,"date":30,"categoryPill":30},[],"1:1",{"id":91,"slug":92,"title":93,"parentId":53,"sortOrder":18,"navVisible":30,"layout":94,"cardType":37,"columns":18,"pageSize":25,"itemFields":95,"contentSource":27,"aggregatePages":96,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":97,"reserved":30,"datePosition":44,"aspectRatio":13},25,"category\u002Fgod","GarfielGod","static",{"cover":22,"title":22,"excerpt":22,"date":22,"categoryPill":22},[],"我真的是人类吗。。。",{"post":99},{"id":100,"slug":101,"title":102,"date":103,"modified":104,"link":105,"content":106,"excerpt":107,"featured":43,"pages":108,"tags":111,"status":112,"format":113,"contentWidth":13,"postStyle":13,"postStyleOptions":114,"allowComments":22,"html":106},537,"%e3%80%8a%e6%88%91%e6%9d%a5%e8%87%aa%e6%9c%aa%e6%9d%a5%e3%80%8b%e5%b9%bb%e6%83%b3","《我来自未来》幻想","2023-05-26T15:51:00","2023-09-06T21:50:32","https:\u002F\u002Fgarfieldgod.cn\u002Findex.php\u002F537\u002F","\n\u003Cp class=\"wp-block-paragraph\">    对了，微机课时想到什么想说的，后来忘了。然后现在想起了，原来是关于现在和未来以及曾经的事情。起因是我前段时间觉得我的生活需要动力，因为我前不久生活的意义因某些事突然消失了，就想回到过去，挽回一下，如同穿越一般。可我又想，我穿越到过去，所有的一切都回到那个时候，包括自己现在的记忆，情感。也就是说我回到过去是不会记得自己是想要改变什么才回去的，那穿越也就毫无意义。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;&nbsp;于是我联想到未来。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    是否有种可能，未来的我或许因为什么事而后悔，因为什么事而回到过去想改变什么，也就是未来的我回到我现在，去改变未来。可我不知道未来的我回到我现在这个时间，是为了改变什么呢？我未来的所见所闻所感所思都在穿越的途中消失，但我认为未来的我是极力想改变什么才回到现在的吧，于是我不想辜负未来的我，我想完成他所想改变的事，而他所想改变的事我却不知道，唯一能够完成他反悔的方法就是在我自己现在做出选择的时候，选择一个或许更好但自己从未尝试过的选项。比如更爱学习什么的。于是我的生活有了意义。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;&nbsp;最后，我想说，如果旧人们看见我不一样了，我变了，请不要惊讶，因为我如今不是过去的我，也不是现在的我，我来自未来。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">                                                                                                                    \u003C\u002Fp>\n\n\n\n\u003Cp class=\"has-text-align-right wp-block-paragraph\">&#8212;&#8212;&#8212;&#8212;&#8211;写于  2017年  9月30日  20:29\u003C\u002Fp>\n","\u003Cp>    对了，微机课时想到什么想说的，后来忘了。然后现在想起了，原来是关于现在和未来以及曾经的事情。起因是我前 [&hellip;]\u003C\u002Fp>\n",[109],{"id":10,"title":79,"slug":78,"path":110,"isHome":30},"\u002Fcategory\u002Flog",[],"published","html",{"tocSide":115,"tocProgress":22,"heroImage":13,"heroSize":37,"miniNav":22,"sectionNumbers":22,"linkUrl":13,"linkDelay":34},"right",{"post":100,"views":18},{"comments":118},[],1791216025512]