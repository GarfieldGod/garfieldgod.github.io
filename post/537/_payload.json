y\u002Fnotes","学习笔记","horizontal",{"title":15,"excerpt":15,"date":15,"cover":34,"categoryPill":34},[],{"id":10,"slug":82,"title":83,"parentId":50,"sortOrder":45,"navVisible":15,"layout":27,"cardType":84,"columns":23,"pageSize":29,"itemFields":85,"contentSource":31,"aggregatePages":86,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":13,"reserved":34,"datePosition":48,"aspectRatio":13},"category\u002Flog","中二日志","editorial",{"title":15,"excerpt":15,"date":15,"cover":15},[],{"id":88,"slug":89,"title":90,"parentId":57,"sortOrder":26,"navVisible":34,"layout":27,"cardType":28,"columns":45,"pageSize":29,"itemFields":91,"contentSource":31,"aggregatePages":92,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":13,"reserved":34,"datePosition":48,"aspectRatio":93},24,"category\u002Ffriendshiplinks","友情链接",{"cover":15,"title":15,"excerpt":15,"date":34,"categoryPill":34},[],"1:1",{"id":95,"slug":96,"title":97,"parentId":57,"sortOrder":23,"navVisible":34,"layout":98,"cardType":41,"columns":23,"pageSize":29,"itemFields":99,"contentSource":31,"aggregatePages":100,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":101,"reserved":34,"datePosition":48,"aspectRatio":13},25,"category\u002Fgod","GarfielGod","static",{"cover":15,"title":15,"excerpt":15,"date":15,"categoryPill":15},[],"我真的是人类吗。。。",{"post":103},{"id":104,"slug":105,"title":106,"date":107,"modified":108,"link":109,"content":110,"excerpt":111,"featured":47,"pages":112,"tags":115,"status":116,"format":117,"contentWidth":13,"postStyle":118,"postStyleOptions":119,"allowComments":15,"bgmSrc":13,"html":110},537,"%e3%80%8a%e6%88%91%e6%9d%a5%e8%87%aa%e6%9c%aa%e6%9d%a5%e3%80%8b%e5%b9%bb%e6%83%b3","《我来自未来》幻想","2023-05-26T15:51:00","2026-10-06T18:44:38.940Z","https:\u002F\u002Fgarfieldgod.cn\u002Findex.php\u002F537\u002F","\n\u003Cp class=\"wp-block-paragraph\">    对了，微机课时想到什么想说的，后来忘了。然后现在想起了，原来是关于现在和未来以及曾经的事情。起因是我前段时间觉得我的生活需要动力，因为我前不久生活的意义因某些事突然消失了，就想回到过去，挽回一下，如同穿越一般。可我又想，我穿越到过去，所有的一切都回到那个时候，包括自己现在的记忆，情感。也就是说我回到过去是不会记得自己是想要改变什么才回去的，那穿越也就毫无意义。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;&nbsp;于是我联想到未来。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    是否有种可能，未来的我或许因为什么事而后悔，因为什么事而回到过去想改变什么，也就是未来的我回到我现在，去改变未来。可我不知道未来的我回到我现在这个时间，是为了改变什么呢？我未来的所见所闻所感所思都在穿越的途中消失，但我认为未来的我是极力想改变什么才回到现在的吧，于是我不想辜负未来的我，我想完成他所想改变的事，而他所想改变的事我却不知道，唯一能够完成他反悔的方法就是在我自己现在做出选择的时候，选择一个或许更好但自己从未尝试过的选项。比如更爱学习什么的。于是我的生活有了意义。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp;&nbsp;最后，我想说，如果旧人们看见我不一样了，我变了，请不要惊讶，因为我如今不是过去的我，也不是现在的我，我来自未来。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">                                                                                                                    \u003C\u002Fp>\n\n\n\n\u003Cp class=\"has-text-align-right wp-block-paragraph\">&#8212;&#8212;&#8212;&#8212;&#8211;写于  2017年  9月30日  20:29\u003C\u002Fp>\n","\u003Cp>    对了，微机课时想到什么想说的，后来忘了。然后现在想起了，原来是关于现在和未来以及曾经的事情。起因是我前 [&hellip;]\u003C\u002Fp>",[113],{"id":10,"title":83,"slug":82,"path":114,"isHome":34},"\u002Fcategory\u002Flog",[],"published","html","classic",{"tocSide":120,"tocProgress":15,"heroImage":13,"heroSize":41,"showByline":15,"dropCap":15,"showLabel":15,"showLede":15,"centerTitle":34,"fullWidthMedia":34,"miniNav":15,"sectionNumbers":15,"linkUrl":13,"linkDelay":38},"right",{"post":104,"views":38},{"comments":123},[],1791388829008]