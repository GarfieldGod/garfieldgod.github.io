y\u002Fnotes","学习笔记","horizontal",{"title":15,"excerpt":15,"date":15,"cover":34,"categoryPill":34},[],{"id":10,"slug":82,"title":83,"parentId":50,"sortOrder":45,"navVisible":15,"layout":27,"cardType":84,"columns":23,"pageSize":29,"itemFields":85,"contentSource":31,"aggregatePages":86,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":13,"reserved":34,"datePosition":48,"aspectRatio":13},"category\u002Flog","中二日志","editorial",{"title":15,"excerpt":15,"date":15,"cover":15},[],{"id":88,"slug":89,"title":90,"parentId":57,"sortOrder":26,"navVisible":34,"layout":27,"cardType":28,"columns":45,"pageSize":29,"itemFields":91,"contentSource":31,"aggregatePages":92,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":13,"reserved":34,"datePosition":48,"aspectRatio":93},24,"category\u002Ffriendshiplinks","友情链接",{"cover":15,"title":15,"excerpt":15,"date":34,"categoryPill":34},[],"1:1",{"id":95,"slug":96,"title":97,"parentId":57,"sortOrder":23,"navVisible":34,"layout":98,"cardType":41,"columns":23,"pageSize":29,"itemFields":99,"contentSource":31,"aggregatePages":100,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":101,"reserved":34,"datePosition":48,"aspectRatio":13},25,"category\u002Fgod","GarfielGod","static",{"cover":15,"title":15,"excerpt":15,"date":15,"categoryPill":15},[],"我真的是人类吗。。。",{"post":103},{"id":104,"slug":105,"title":106,"date":107,"modified":108,"link":109,"content":110,"excerpt":111,"featured":112,"pages":113,"tags":116,"status":117,"format":118,"contentWidth":13,"postStyle":119,"postStyleOptions":120,"allowComments":15,"bgmSrc":13,"html":110},541,"%e3%80%8a%e5%85%b6%e5%ae%9e%e6%88%91%e6%98%af%e5%ae%87%e5%ae%99%e4%ba%ba%e3%80%8b%e5%b9%bb%e6%83%b3","《其实我是宇宙人》幻想","2023-05-26T15:56:52","2026-10-06T18:44:38.462Z","https:\u002F\u002Fgarfieldgod.cn\u002Findex.php\u002F541\u002F","\n\u003Cp class=\"wp-block-paragraph\">    其实我是宇宙人，一直瞒着大伙。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    我从宇宙中来到地球，潜伏于世间，伪装成人类。 地球是一个美好的地方，我沉溺于这里的许多事，喜欢上许多人，爱上无数事物，我已忘记了我的使命。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    不过无所谓了，恰如我说出我的真实身份，也已无所谓了，我总会不断询问周围的人们一个问题“我看起来是否像一个人类”，答案都是说像的，那我的伪装就已是成功了。那我不就是人类？我的目的或使命，变成体验作为一个人类的一生，也未尝不可。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    但，在人群中还是会感到焦虑，如同身处异乡周围皆是陌生人般恐惧，更何况是深处异星，置身异星人之中，难以拥有归属感。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    偶尔也会想回到宇宙中去。但地球也让我流连，若是离开大概再也无法归来。潜伏过程中我已获得了人类的感情。我一定会思念，思念过去在这里的日子，思念如人类般的体验，忘不掉可爱的人儿。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    这里的人会有思念我吗，在知道了我是宇宙人以后，在我回到宇宙中之后。我来过，但只是经过，作为客人，作为流星划过。好想再体验作为人类的时光，想见尽地球世间万象，与人类打交道，尝遍四海风土人情。只是我的时间不多了，宇宙人最终还是要回到宇宙，再过几十年时光，只是眨眼见，只是待会儿，马上，只是“现在”。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    感到遗憾，也不太遗憾。伪装成人类，与人类相处，我是真心或假意已不清楚。但却庆幸，想继续下去这件伟大的事业，感叹这件事大概做不了多久了。晃晃几近百年，太过短些了。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    终究是要回宇宙的。烟花綻放完便消散了，可是人们看烟花也只会感到美丽而不为其消散而悲伤。生而为美丽，生而为消散。作为人类的一生大概也是如此。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">     等再几十年，我回到宇宙中后，会想念大伙的，曾在一个名为地球的地方，与人同乐。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"has-text-align-right wp-block-paragraph\">&#8212;&#8212;写于\u003Ca href=\"http:\u002F\u002Fuser.qzone.qq.com\u002F1351763110\u002Fmood\u002Fa6449250109d2f64c9650c00.1\">2023年4月7日\u003C\u002Fa>\u003C\u002Fp>\n\n\n\n\u003Cfigure class=\"wp-block-image size-full\">\u003Cimg loading=\"lazy\" decoding=\"async\" width=\"1155\" height=\"2560\" src=\"\u002Fuploads\u002Fposts\u002F541\u002F271-L3-scaled.jpg\" alt=\"\" class=\"wp-image-271\" \u002F>\u003C\u002Ffigure>\n","\u003Cp>其实我是宇宙人，一直瞒着大伙。 我从宇宙中来到地球，潜伏于世间，伪装成人类。 地球是一个美好的地方，我沉溺于这 [&hellip;]\u003C\u002Fp>","\u002Fuploads\u002Fposts\u002F541\u002F271-L3-scaled.jpg",[114],{"id":10,"title":83,"slug":82,"path":115,"isHome":34},"\u002Fcategory\u002Flog",[],"published","html","classic",{"tocSide":121,"tocProgress":15,"heroImage":13,"heroSize":41,"showByline":15,"dropCap":15,"showLabel":15,"showLede":15,"centerTitle":34,"fullWidthMedia":34,"miniNav":15,"sectionNumbers":15,"linkUrl":13,"linkDelay":38},"right",{"post":104,"views":38},{"comments":124},[],1791561628469]