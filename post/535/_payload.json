tOrder":41,"navVisible":22,"layout":23,"cardType":80,"columns":18,"pageSize":25,"itemFields":81,"contentSource":27,"aggregatePages":82,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":13,"reserved":30,"datePosition":44,"aspectRatio":13},"category\u002Flog","中二日志","editorial",{"title":22,"excerpt":22,"date":22,"cover":22},[],{"id":84,"slug":85,"title":86,"parentId":53,"sortOrder":21,"navVisible":30,"layout":23,"cardType":24,"columns":41,"pageSize":25,"itemFields":87,"contentSource":27,"aggregatePages":88,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":13,"reserved":30,"datePosition":44,"aspectRatio":89},24,"category\u002Ffriendshiplinks","友情链接",{"cover":22,"title":22,"excerpt":22,"date":30,"categoryPill":30},[],"1:1",{"id":91,"slug":92,"title":93,"parentId":53,"sortOrder":18,"navVisible":30,"layout":94,"cardType":37,"columns":18,"pageSize":25,"itemFields":95,"contentSource":27,"aggregatePages":96,"latestLimit":25,"showCover":30,"coverImage":43,"isHome":30,"tagFilter":30,"showChildDetail":22,"content":97,"reserved":30,"datePosition":44,"aspectRatio":13},25,"category\u002Fgod","GarfielGod","static",{"cover":22,"title":22,"excerpt":22,"date":22,"categoryPill":22},[],"我真的是人类吗。。。",{"post":99},{"id":100,"slug":101,"title":102,"date":103,"modified":104,"link":105,"content":106,"excerpt":107,"featured":43,"pages":108,"tags":111,"status":112,"format":113,"contentWidth":13,"postStyle":13,"postStyleOptions":114,"allowComments":22,"html":106},535,"%e4%ba%ba%e9%81%93%e4%b8%bb%e4%b9%89%e5%8f%91%e5%b1%95%e7%9a%84%e7%9f%9b%e7%9b%be","人道主义发展的矛盾","2023-05-26T15:49:55","2023-09-06T21:50:36","https:\u002F\u002Fgarfieldgod.cn\u002Findex.php\u002F535\u002F","\n\u003Cp class=\"wp-block-paragraph\">《城市：天际线》中，我在建设我的城市时，遇到了一些棘手的问题。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp; &nbsp; &nbsp; 1.工业区的工厂没有工人工作，许多工厂最终都被废弃了，新建的工厂不就也出现类似的情况，初级劳动力太少，没有人愿意去工厂工作，然而人口是足够的，甚至溢出的，许多人抱怨没有工作，这是为什么？我苦思许久，最后搜了攻略，才明白－－－居民教育程度太高，都向往更好的生活，没人愿意去工厂当工人，解决方法之一是降低工业生产规模，然而发展需要，并不能这么做。另外一个解决方法则是：教育控制。即教育有限分配，比如我本来是有能力让更多人接受高等教育的，但我此时需要低级劳动力，我就不能让一些人接受教育，即使我有这个能力。这把我震惊了。我挣扎了许久，最终妥协了，将一处居民区周围的一所大学与几所中小学拆除了，最终工业区劳动力问题得到了解决，但我却很愧疚，这一切值得吗？现代社会应该不会出现这样建了又拆的情况，但我想，某个时代，受于某种压力，也许就会发生有能力建造学校却故意不建造的情况。多么可悲。工人型劳动力在未来如果真的能被全部消失并取代，也许社会发展会更人道些吧。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;2.关于区域的划分，从普通的闹市区，到以上提到的学校等设施很少的“工人区”，再到新建的高新区，我不得不发现这其实像是一种等级制度，工人区距离工业区更近，上班下班更容易，但也因此周围污染更严重，居民身体健康更差，经常发生各种事情，各种资源也因身处工业区而更少，更像是“贫民区”。而新建的高新区因其高度集中的办公楼与居民大厦，商业大厦等，不得不优先建立地铁干线，增多公交线，其带来的经济效益确实更大，为保障其正常运转，所设置的医疗，安保，消防等等资源也更多，居民满意度更高，但这好吗，这似乎被迫形成了区别对待。为了发展，为了进阶，被迫优先优待高新区的人们，从宏观角度上看，这是正确的，高度发展的地区可以带动其他地区，但对于一个时代的某些个体，这并不公平，这不人道，这就是牺牲了他们，来换取社会总体的发展。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;还有一些人道与发展直接的矛盾，就不赘述了。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">         我不是文科生，啥也不懂，都是乱说的。\u003C\u002Fp>\n","\u003Cp>《城市：天际线》中，我在建设我的城市时，遇到了一些棘手的问题。 &nbsp; &nbsp; &nbsp; &#038;n [&hellip;]\u003C\u002Fp>\n",[109],{"id":10,"title":79,"slug":78,"path":110,"isHome":30},"\u002Fcategory\u002Flog",[],"published","html",{"tocSide":115,"tocProgress":22,"heroImage":13,"heroSize":37,"miniNav":22,"sectionNumbers":22,"linkUrl":13,"linkDelay":34},"right",{"post":100,"views":21},{"comments":118},[],1791144788358]