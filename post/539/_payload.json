y\u002Fnotes","学习笔记","horizontal",{"title":15,"excerpt":15,"date":15,"cover":34,"categoryPill":34},[],{"id":10,"slug":82,"title":83,"parentId":50,"sortOrder":45,"navVisible":15,"layout":27,"cardType":84,"columns":23,"pageSize":29,"itemFields":85,"contentSource":31,"aggregatePages":86,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":13,"reserved":34,"datePosition":48,"aspectRatio":13},"category\u002Flog","中二日志","editorial",{"title":15,"excerpt":15,"date":15,"cover":15},[],{"id":88,"slug":89,"title":90,"parentId":57,"sortOrder":26,"navVisible":34,"layout":27,"cardType":28,"columns":45,"pageSize":29,"itemFields":91,"contentSource":31,"aggregatePages":92,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":13,"reserved":34,"datePosition":48,"aspectRatio":93},24,"category\u002Ffriendshiplinks","友情链接",{"cover":15,"title":15,"excerpt":15,"date":34,"categoryPill":34},[],"1:1",{"id":95,"slug":96,"title":97,"parentId":57,"sortOrder":23,"navVisible":34,"layout":98,"cardType":41,"columns":23,"pageSize":29,"itemFields":99,"contentSource":31,"aggregatePages":100,"latestLimit":29,"showCover":34,"coverImage":47,"isHome":34,"tagFilter":34,"showChildDetail":15,"content":101,"reserved":34,"datePosition":48,"aspectRatio":13},25,"category\u002Fgod","GarfielGod","static",{"cover":15,"title":15,"excerpt":15,"date":15,"categoryPill":15},[],"我真的是人类吗。。。",{"post":103},{"id":104,"slug":105,"title":106,"date":107,"modified":108,"link":109,"content":110,"excerpt":111,"featured":47,"pages":112,"tags":115,"status":116,"format":117,"contentWidth":13,"postStyle":118,"postStyleOptions":119,"allowComments":15,"bgmSrc":13,"html":110},539,"%e3%80%8a%e6%88%91%e6%9d%a5%e8%87%aa%e6%9c%aa%e6%9d%a5%e3%80%8b2","《我来自未来》2","2023-05-26T15:54:11","2026-10-06T18:44:38.467Z","https:\u002F\u002Fgarfieldgod.cn\u002Findex.php\u002F539\u002F","\n\u003Cp class=\"wp-block-paragraph\">    一些天马行空的乱想幻想：\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">     昨日还是前日梦见一个和穿越时空有关的事 于是想起多年前的一些想法，但现在又有所改观，有一些其他的幻想 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    多年前的想法是： “ 我感觉我可能是一个时空穿越者 我理解的时空穿越理应是一切复原到以前的某个状态，我自己本身也同样。 因此我从未来穿越时间回到现在，并不会保留我未来的记忆，我也不会意识到我是穿越者。 由此，现在的我产生了‘我有可能是穿越者只是我失去了记忆，没有意识到而已’ ” \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    当时的我是认为未来的我费那么大力气非要穿越回来，一定是为了改变什么，做了什么事情而后悔而回来。这样的想法是会让当时的我做出改变的，我当时决心在做一些事的时候一定要试试其他我可能本不可能会试的选择，这样也许能完成”未来的我“的目标。让我去勇敢地尝试。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    现在我感觉也许不是这样，毕竟如果是未来的“我”的话，应该会考虑到穿越途中我自己的记忆也会消失，那对于未来的”我“来说改变过去等于空谈，毕竟现在的我根本不知道未来是怎样的，不管我怎么做，也许都就是原本的”未来”，我的时空是完全没有受到未来的影响的。那我怎么可能改变未来呢。 \u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    想了许久，还是没有思索出合理的原因。非要说的话，我觉得，可能是我想，重新体验一遍现在的生活吧。 即使现在的生活也许对现在的我并不能感到特别特别的兴奋快乐，但未来的我，肯定也会怀念现在的生活吧，就像现在的我怀念过去一样，过去我是否也并没有发现过去的生活很幸福呢？ “也许我的一生是平淡的，不是那么精彩的，但对于我来说是独一无二的，好事也好，坏事也好，悲伤也好，幸福也好，都是我的经历。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    我喜欢的经历，我喜欢我自己，热爱我的一生”如果未来的我真的考虑到现在我无法意识到自己是穿越者，知道现在的我无法改变什么，那为什么还要回来呢？那一定就是这样吧。我的一生太精彩，太平淡。“我”想再回来看看，我想再好好珍稀现在的时光 想起这样中二的幻想，感觉有些好笑，但又觉得有些启发，也不是毫无意义吧 但这个幻想本身的前提是我是一个穿越者，我不得不考虑我不是穿越者怎么办呢。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"wp-block-paragraph\">    我想到既然是穿越的话，那是世间一切都一起复原的吧，我不是穿越者，也许总有人是，他或她在穿越的过程中，我也复原成现在的状态了。 所以，你也可能是穿越者，也好好珍惜现在的时光吧。\u003C\u002Fp>\n\n\n\n\u003Cp class=\"has-text-align-right wp-block-paragraph\">&#8212;&#8212;&#8212;-写于\u003Ca href=\"http:\u002F\u002Fuser.qzone.qq.com\u002F1351763110\u002Fmood\u002Fa6449250f11d876296940d00.1\">2022年5月20日\u003C\u002Fa>\u003C\u002Fp>\n","\u003Cp>一些天马行空的乱想幻想： 昨日还是前日梦见一个和穿越时空有关的事 于是想起多年前的一些想法，但现在又有所改观， [&hellip;]\u003C\u002Fp>",[113],{"id":10,"title":83,"slug":82,"path":114,"isHome":34},"\u002Fcategory\u002Flog",[],"published","html","classic",{"tocSide":120,"tocProgress":15,"heroImage":13,"heroSize":41,"showByline":15,"dropCap":15,"showLabel":15,"showLede":15,"centerTitle":34,"fullWidthMedia":34,"miniNav":15,"sectionNumbers":15,"linkUrl":13,"linkDelay":38},"right",{"post":104,"views":50},{"comments":123},[],1791561628414]